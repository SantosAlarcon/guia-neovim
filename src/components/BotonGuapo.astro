---
const { icono, texto, url } = Astro.props;
---

<a href={url}>
	<div class="boton__guapo__container">
		<span class="boton__guapo__icono">
			<img src={icono} />
		</span>
		<div class="boton__guapo__texto">
			{texto}
		</div>
	</div>
</a>

<style>
	a {
		&:hover {
			color: inherit;
			text-shadow: inherit;
		}
	}
	.boton__guapo__container {
		display: flex;
		align-items: center;
		padding: 1rem;
	}

	.boton__guapo__icono {
		stroke: white;
		display: flex;
		width: 3rem;
		height: 3rem;
		background: linear-gradient(0deg, #006 0%, #009 100%);
		border-radius: 0.8rem 0 0 0.8rem;
		padding: 0.4rem 1rem;
	}

	.boton__guapo__texto {
		border-radius: 0 0.8rem 0.8rem 0;
		background: linear-gradient(0deg, #00f 0%, #33f 100%);
		padding: 0.6rem 1rem;
		width: 100%;
	}
</style>
