---
import Layout from "../layouts/Layout.astro";
import LogoNeovim from "../components/LogoNeovim.astro";
import BotonGuapo from "../components/BotonGuapo.astro";
import enlaces from "../enlaces.json"

const postJSONLd = {
    "@context": "https://schema.org",
    "@type": "Thing",
    name: "Inicio | Guía Neovim",
    url: Astro.url,
};
---
<Layout title="Inicio | Guía Neovim">
    <main class="main__container">
        <LogoNeovim height="330" />
        <h1>¿Qué es Neovim?</h1>
        <p>
            <b>Neovim</b> es un editor de textos muy potente y <b
                >multiplataforma</b
            >, basado en el mítico <b>Vim</b>, pero mucho más extensible, y con
            soporte del lenguaje <b>Lua</b>.
        </p>

        <h2>¿Y de qué va esta guía?</h2>
        <p>
            Si alguna vez has tratado de utilizar este editor, y no has podido
            salir de él, no te preocupes. Con esta guía podrás dominar este
            editor de una forma fácil y muy sencilla. Abarcará desde los atajos
            de teclado hasta los diferentes plugins importantes.
        </p>
        <div class="main__botones" role="navigation" aria-label="Navegación principal">
			{
			enlaces.map((enlace) => <BotonGuapo width="auto" height="auto" icono={
				enlace.icono
				} url={
				enlace.ruta
				} texto={
				enlace.titulo
				} />)
			}
        </div>
        <p class="keyboard-hint">
			<kbd>Tab</kbd> para navegar, &nbsp;&nbsp;&nbsp;<kbd>Enter</kbd> para seleccionar
        </p>
    </main>
</Layout>

<style>
    .main__container {
        width: 100%;
        margin: auto;
        font-size: clamp(1rem, 2vw, 1.25rem);
        text-align: center;
        transition: none;
        padding: 4rem 0;
    }

    .main__botones {
        margin: 2em auto 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
        gap: 1.25rem;
        padding: 0 1rem;
    }

    h1 {
        font-size: 4rem;
        font-weight: 700;
        line-height: 1;
        text-align: center;
        margin-bottom: 1em;
    }

    .keyboard-hint {
        margin-top: 3.5em;
        font-size: 1rem;
        opacity: 0.75;
		color: light-dark(var(--light-fg), var(--dark-fg));
    }

    @media (prefers-reduced-motion: no-preference) {
        .main__botones > * {
            opacity: 0;
            animation: cardIn 0.5s ease forwards;
        }

        .main__botones > *:nth-child(1) { animation-delay: 0s; }
        .main__botones > *:nth-child(2) { animation-delay: 0.06s; }
        .main__botones > *:nth-child(3) { animation-delay: 0.12s; }
        .main__botones > *:nth-child(4) { animation-delay: 0.18s; }
        .main__botones > *:nth-child(5) { animation-delay: 0.24s; }
        .main__botones > *:nth-child(6) { animation-delay: 0.3s; }
        .main__botones > *:nth-child(7) { animation-delay: 0.36s; }
    }

    @keyframes cardIn {
        from {
            opacity: 0;
            transform: translateY(1.25rem) scale(0.97);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
</style>

<script>
    const links = document.querySelectorAll('.main__botones a');
    
    document.addEventListener('keydown', (e) => {
        const target = e.target;
        if (!links.includes(target)) return;
        
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
            e.preventDefault();
            const next = target.nextElementSibling;
            if (next) next.focus();
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
            e.preventDefault();
            const prev = target.previousElementSibling;
            if (prev) prev.focus();
        }
    });
</script>

<script type="application/ld+json" set:html={JSON.stringify(postJSONLd)}>
</script>
